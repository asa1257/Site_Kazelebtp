# Copier ce fichier en .env.local et remplir les valeurs. .env.local n'est JAMAIS envoyé sur GitHub.
# Sans ces valeurs, en développement, les demandes de devis sont affichées dans le terminal au lieu d'être envoyées.

# --- Anti-robot Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile) ---
# Clés de test Cloudflare (toujours valides) pour essayer en local :
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# --- Envoi des e-mails via Resend (https://resend.com) ---
RESEND_API_KEY=
# Adresse d'expédition sur votre domaine vérifié dans Resend
DEVIS_FROM="KAZELE Devis <devis@votre-domaine.ci>"

# --- Destinataires des demandes ---
# Obligatoire : adresse qui reçoit tout si aucune adresse par pôle n'est renseignée
DEVIS_TO_DEFAULT=
# Facultatif : une adresse par pôle, et une pour les projets multi-pôles
DEVIS_TO_INFORMATIQUE=
DEVIS_TO_CONSTRUCTION=
DEVIS_TO_HYDRAULIQUE=
DEVIS_TO_MAINTENANCE=
DEVIS_TO_COORDINATION=
